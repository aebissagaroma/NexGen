# ─────────────────────────────────────────────────────────────
# ELECTROCUP 26 — environment
# Copy to .env.local for local dev; set these in Render/Vercel for prod.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:  postgres://postgres:postgres@localhost:5432/electrocup
# Render: use the "Internal Database URL" from the Render Postgres dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/electrocup

# Set to "true" when connecting to a managed PG that requires SSL (Render/Neon/Supabase).
PGSSL=false

# Secret used to sign session cookies (HMAC). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin login (used by /api/admin/login). Change before deploying.
ADMIN_EMAIL=admin@nexgenplc.com
ADMIN_PASSWORD=change-me

# Email OTP delivery via SMTP. Leave SMTP_HOST unset = DEV MODE: the 6-digit code
# is returned in the API response and logged to the server console (no email sent).
# See src/lib/otp.ts. For production, use any SMTP provider:
#   Gmail:  host=smtp.gmail.com  port=587  user=<you>@gmail.com  pass=<app password>
#   Brevo:  host=smtp-relay.brevo.com  port=587  user=<login>  pass=<smtp key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address shown on the OTP email (must be allowed by your provider).
SMTP_FROM=ELECTROCUP <no-reply@electrocup.com>
