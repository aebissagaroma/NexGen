# ─────────────────────────────────────────────────────────────
# ELECTROCUP 26 — environment
# Copy to .env.local for local dev; set these in Render/Vercel for prod.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:  postgres://postgres:postgres@localhost:5432/electrocup
# Render: use the "Internal Database URL" from the Render Postgres dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/electrocup

# Postgres TLS mode:
#   true      → TLS with certificate verification (use for Neon and any managed
#               PG with publicly-trusted certs — the production setting)
#   no-verify → TLS without verification (only for providers with self-signed
#               chains, e.g. Render internal URLs)
#   false     → plain TCP (local dev only)
PGSSL=false

# Max Postgres connections per app instance (default 3). On serverless each
# concurrent function builds its own pool, so keep this small and let the
# platform pooler multiplex. Raise only for a single long-lived Node server.
PGPOOL_MAX=3

# Secret used to sign session cookies (HMAC). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin login (used by /api/admin/login). Change before deploying.
ADMIN_EMAIL=admin@nexgenplc.com
ADMIN_PASSWORD=change-me

# Email OTP delivery via SMTP. Leave SMTP_HOST unset = DEV MODE: the 6-digit code
# is returned in the API response and logged to the server console (no email sent).
# See src/lib/otp.ts. Verify credentials with: npm run email:test -- you@example.com
#
# Resend (configured provider — needs a VERIFIED DOMAIN before it will send):
#   host=smtp.resend.com  port=587  user=resend  pass=<re_… API key>
#   NOTE: SMTP_USER is the literal word "resend", not an email address.
# Brevo (works without a domain — verify a single sender address):
#   host=smtp-relay.brevo.com  port=587  user=<smtp login>  pass=<smtp key>
# Gmail (testing only):
#   host=smtp.gmail.com  port=587  user=<you>@gmail.com  pass=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address on the OTP email. Must be on a domain/sender verified with
# your provider. A no-reply@ address needs no mailbox.
SMTP_FROM=ELECTROCUP <no-reply@electrocup.com>

# Where staff notifications go: a copy of every new registration, and every
# appeal against a disqualification. Falls back to SMTP_FROM if unset — which is
# usually a no-reply address nobody reads, so set this to a real inbox.
OPS_EMAIL=ops@nexgenplc.com

# Set to 'false' to stop emailing staff about EVERY registration. The daily
# summary still runs either way — useful if per-entry mail gets noisy at launch.
OPS_NOTIFY_EACH=true

# Protects the scheduled daily summary (see `crons` in vercel.json). Vercel sends
# this as `Authorization: Bearer <value>`. Without it the endpoint refuses to run
# rather than sit open. Any long random string.
CRON_SECRET=
