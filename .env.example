# ─────────────────────────────────────────────────────────────
# ELECTROCUP 26 — environment
# Copy to .env.local for local dev; set these in Render/Vercel for prod.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:  postgres://postgres:postgres@localhost:5432/electrocup
# Render: use the "Internal Database URL" from the Render Postgres dashboard.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/electrocup

# Set to "true" when connecting to a managed PG that requires SSL (Render/Neon/Supabase).
PGSSL=false

# Secret used to sign session cookies (HMAC). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap admin login (used by /api/admin/login). Change before deploying.
ADMIN_EMAIL=admin@nexgenplc.com
ADMIN_PASSWORD=change-me

# OTP delivery. Left unset = DEV MODE: the 6-digit code is returned in the API
# response and logged to the server console (no SMS sent). See src/lib/otp.ts.
# TODO(dev): wire a real SMS provider (Afromessage / Twilio / GeezSMS) here.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=ELECTROCUP
